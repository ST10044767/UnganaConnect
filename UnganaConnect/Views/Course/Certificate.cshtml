@model UnganaConnect.Frontend.Models.CertificateViewModel
@{
    ViewData["Title"] = "Certificate";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 via-white to-indigo-100 py-10 px-4">
    <div class="relative bg-white shadow-2xl rounded-2xl border-[12px] border-double border-gray-300 w-full max-w-4xl overflow-hidden print:border-black">

        <!-- Decorative corner ribbons -->
        <div class="absolute top-0 left-0 w-20 h-20 bg-indigo-100 rounded-br-3xl"></div>
        <div class="absolute top-0 right-0 w-20 h-20 bg-indigo-100 rounded-bl-3xl"></div>
        <div class="absolute bottom-0 left-0 w-20 h-20 bg-indigo-100 rounded-tr-3xl"></div>
        <div class="absolute bottom-0 right-0 w-20 h-20 bg-indigo-100 rounded-tl-3xl"></div>

        <!-- Certificate content -->
        <div class="relative z-10 p-10 text-center">

            <!-- Logo Section -->
            <div class="flex justify-center mb-6">
                <img src="/logo.png" alt="Organization Logo" class="h-20 w-auto object-contain">
            </div>

            <h1 class="text-4xl font-extrabold tracking-wide text-gray-800 mb-1">
                Certificate of Completion
            </h1>
            <p class="text-gray-500 text-sm mb-6">Certificate ID: @Model.CertificateId</p>

            <hr class="border-t border-gray-300 mb-6" />

            <p class="text-lg text-gray-700 mb-3">This is to certify that</p>
            <h2 class="text-3xl font-semibold text-indigo-700 mb-4">@Model.UserName</h2>
            <p class="text-lg text-gray-700 mb-3">has successfully completed the course</p>
            <h3 class="text-2xl font-medium text-gray-800 mb-6">@Model.CourseTitle</h3>

            <div class="text-gray-500 mb-8 space-y-1">
                <p>Instructors: <span class="font-medium text-gray-700">@Model.Instructor</span></p>
                <p>Date: <span class="font-medium text-gray-700">@Model.CompletionDate</span></p>
            </div>

            <div class="flex justify-center gap-4">
                <button onclick="window.print()"
                        class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-indigo-500 text-indigo-600 hover:bg-indigo-50 rounded-lg font-medium transition">
                    <i class="fas fa-print"></i> Print
                </button>

                <a href="@Url.Action("Details", "Course", new { id = 0 })"
                   class="inline-flex items-center gap-2 px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium transition">
                    Back to Courses
                </a>
            </div>
        </div>
    </div>
</div>
