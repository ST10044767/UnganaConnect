@model UnganaConnect.Models.Course.Quiz
@{
    ViewData["Title"] = "Create Quiz";
}

<div class="max-w-4xl mx-auto py-10 px-4">
    <!-- Header -->
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Create Quiz</h1>
        <p class="text-gray-600">Add a new quiz for <span class="font-medium text-primary-600">@ViewBag.ModuleTitle</span></p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <form asp-action="CreateQuiz" method="post" class="space-y-6">
            <input type="hidden" asp-for="ModuleId" />

            <!-- Quiz Title -->
            <div>
                <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-2">
                    Quiz Title <span class="text-red-500">*</span>
                </label>
                <input asp-for="Title"
                       class="block w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500
                              focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                       placeholder="Enter quiz title" required />
                <span asp-validation-for="Title" class="text-red-600 text-xs mt-1"></span>
            </div>

            <!-- Instructions -->
            <div>
                <label asp-for="Instructions" class="block text-sm font-medium text-gray-700 mb-2">Instructions</label>
                <textarea asp-for="Instructions" rows="4"
                          class="block w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500
                                 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                          placeholder="Add quiz instructions (optional)"></textarea>
            </div>

            <hr class="border-gray-200 my-6" />

            <!-- Dynamic Questions -->
            <div id="questions" class="space-y-6">
                <!-- Dynamic JS insertion -->
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-4 pt-6 border-t border-gray-200">
                <button type="button" id="add-question"
                        class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50
                               transition-colors font-medium">
                    <i class="fas fa-plus"></i> Add Question
                </button>

                <button type="submit"
                        class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary-600 text-white rounded-lg hover:bg-primary-700
                               transition-colors font-medium">
                    <i class="fas fa-save"></i> Create Quiz
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<script>
    (function () {
        const questions = document.getElementById('questions');
        const addBtn = document.getElementById('add-question');
        let qIndex = 0;

        function addQuestion() {
            const qWrap = document.createElement('div');
            qWrap.className = 'border border-gray-200 rounded-xl p-5 shadow-sm bg-gray-50';
            qWrap.innerHTML = `
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Question</label>
                    <input name="questionTexts[${qIndex}]"
                           class="block w-full px-4 py-2.5 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-400
                                  focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                           placeholder="Enter question text" />
                </div>
                <div data-options class="space-y-2"></div>
                <div class="mt-3 flex justify-start">
                    <button type="button" class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-700
                            hover:bg-gray-100 transition" data-add-option>
                        <i class="fas fa-plus text-primary-600 mr-1"></i> Add Option
                    </button>
                </div>
            `;

            const optionsHost = qWrap.querySelector('[data-options]');
            const addOptionBtn = qWrap.querySelector('[data-add-option]');
            let oIndex = 0;

            function addOption() {
                const opt = document.createElement('div');
                opt.className = 'flex items-center gap-2';
                opt.innerHTML = `
                    <input class="h-4 w-4 text-primary-600 border-gray-300 focus:ring-primary-500"
                           type="radio" name="correctOptionIndexes[${qIndex}]" value="${oIndex}" />
                    <input class="flex-1 px-3 py-2 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-400
                                 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                           name="options[${qIndex}][${oIndex}]" placeholder="Option text" />
                `;
                optionsHost.appendChild(opt);
                oIndex++;
            }

            addOptionBtn.addEventListener('click', addOption);
            addOption(); // default 2 options
            addOption();
            questions.appendChild(qWrap);
            qIndex++;
        }

        addBtn.addEventListener('click', addQuestion);
        addQuestion();
    })();
</script>
