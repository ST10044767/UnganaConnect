@model UnganaConnect.Models.Course.Module
@{
    ViewData["Title"] = "Edit Module";
}

<div class="max-w-4xl mx-auto py-10 px-4">
    <!-- Header -->
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Edit Module</h1>
        <p class="text-gray-600">Update details for this course module</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <form asp-action="EditModule" method="post" enctype="multipart/form-data" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <!-- Title & Order -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-2">
                        Module Title <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Title"
                           class="block w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500
                                  focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                           placeholder="Enter module title" required />
                    <span asp-validation-for="Title" class="text-red-600 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="Order" class="block text-sm font-medium text-gray-700 mb-2">
                        Order <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Order" type="number"
                           class="block w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500
                                  focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                           placeholder="e.g., 1, 2, 3..." required />
                </div>
            </div>

            <!-- Content -->
            <div>
                <label asp-for="Content" class="block text-sm font-medium text-gray-700 mb-2">
                    Content
                </label>
                <textarea asp-for="Content" rows="5"
                          class="block w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-500
                                 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                          placeholder="Add module content..."></textarea>
            </div>

            <!-- Video Upload -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Replace Video</label>
                <input type="file" name="newVideo" accept="video/*"
                       class="block w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900
                              focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" />
                <p class="text-xs text-gray-500 mt-1">Upload a new video file to replace the existing one (optional)</p>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-4 pt-6 border-t border-gray-200">
                <a asp-action="Details" asp-route-id="@Model.CourseId"
                   class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium">
                    Cancel
                </a>
                <button type="submit"
                        class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors font-medium inline-flex items-center gap-2">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
