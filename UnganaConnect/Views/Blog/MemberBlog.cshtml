@model List<UnganaConnect.Models.Blog.BlogPostViewModel>

@{
    // Use the first post in the list
    var post = Model.FirstOrDefault();
    if (post == null)
    {
        <text>No blog post found.</text>
        return;
    }

    ViewData["Title"] = post.Title;
    var userEmail = Context.Session.GetString("UserEmail");
    var userRole = Context.Session.GetString("Role");
}

<div class="max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2 text-sm text-gray-600">
            <li><a asp-action="Index" asp-controller="Blog" class="hover:text-primary-600 transition-colors">Blog</a></li>
            <li><i class="fas fa-chevron-right text-gray-400"></i></li>
            <li class="text-gray-900">@post.Title</li>
            <li class="text-gray-900">@post.Content</li>
        </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Blog Content -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Blog Header -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex-1">
                        <h1 class="text-3xl font-bold text-gray-900 mb-2">@post.Title</h1>
                        <p class="text-gray-600 mb-1">by @post.AuthorName</p>
                        <div class="flex items-center text-sm text-gray-600">
                            <i class="fas fa-calendar text-primary-600 mr-2"></i>
                            <span>@post.PublishedAt?.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                    <div class="text-right ml-6">
                        @if (!string.IsNullOrEmpty(post.Category))
                        {
                            <span class="px-3 py-1 text-xs font-semibold text-primary-700 bg-primary-50 rounded-full">
                                @post.Category
                            </span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                {
                    <div class="mb-6">
                        <img src="@post.FeaturedImageUrl" alt="@post.Title" class="w-full rounded-lg object-cover max-h-96" />
                    </div>
                }

                <div class="prose prose-gray max-w-none text-gray-700 leading-relaxed">
                    @Html.Raw(post.Content)
                </div>
            </div>

            <!-- Tags Card -->
            @if (post.Tags != null && post.Tags.Any())
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Tags</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in post.Tags)
                        {
                            <span class="px-3 py-1 text-sm font-medium text-gray-700 bg-gray-100 rounded-full">@tag</span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Related Posts -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Related Posts</h3>
                <ul class="space-y-3">
                    @foreach (var related in ViewBag.RelatedPosts ?? new List<UnganaConnect.Models.Blog.BlogPost>())
                    {
                        <li>
                            <a asp-action="Details" asp-controller="Blog" asp-route-id="@related.Id"
                               class="text-gray-700 hover:text-primary-600 transition-colors font-medium block">
                                @related.Title
                            </a>
                            <p class="text-xs text-gray-500">@related.PublishedDate.ToString("MMM dd, yyyy")</p>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Optional blog interaction scripts
        });
    </script>
}
