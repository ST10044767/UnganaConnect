@model ResourceLibraryViewModel
@{
    ViewData["Title"] = "Resource Library";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6">Resource Library</h1>
            <p class="text-muted">Access comprehensive resources to enhance your CSO's capabilities</p>
        </div>
    </div>

    <div class="row">
        @foreach (var resource in Model.Resources)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title">@resource.Title</h5>
                            <span class="badge bg-primary">@resource.Type</span>
                        </div>
                        
                        <p class="card-text text-muted">@resource.Description</p>
                        
                        <div class="mb-3">
                            <span class="badge bg-secondary me-2">@resource.Category</span>
                            <small class="text-muted">
                                <i class="fas fa-download me-1"></i>@resource.Downloads downloads
                            </small>
                        </div>
                    </div>
                    
                    <div class="card-footer">
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("Preview", new { id = resource.Id })" class="btn btn-outline-primary">
                                <i class="fas fa-eye me-2"></i>Preview
                            </a>
                            <form asp-action="Download" asp-route-id="@resource.Id" method="post" style="display: inline;">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-download me-2"></i>Download
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>