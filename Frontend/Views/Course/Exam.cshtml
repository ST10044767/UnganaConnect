@model ExamViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header">
                    <h4 class="mb-0">@Model.Title</h4>
                    <small class="text-muted">Answer all questions to complete the course</small>
                </div>
                
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    
                    <form asp-action="SubmitExam" method="post">
                        <input type="hidden" name="id" value="@Model.CourseId" />
                        
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var question = Model.Questions[i];
                            <div class="mb-4">
                                <h6>@(i + 1). @question.Question</h6>
                                @for (int j = 0; j < question.Options.Length; j++)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="answers[@question.Id]" value="@question.Options[j]" id="q@(question.Id)_@j" required>
                                        <label class="form-check-label" for="q@(question.Id)_@j">
                                            @question.Options[j]
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Submit Exam</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>