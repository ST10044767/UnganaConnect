@{
    ViewData["Title"] = "Course Completed";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-trophy fa-4x text-warning"></i>
                    </div>
                    
                    <h1 class="text-success mb-4">Course Completed!</h1>
                    <h3 class="mb-3">Database Management Systems</h3>
                    <p class="lead">You have successfully completed this course with a score of 95%</p>
                    
                    <div class="mt-4">
                        <a href="@Url.Action("DownloadCertificate", new { id = 2 })" class="btn btn-success btn-lg me-3">
                            <i class="fas fa-download me-2"></i>Download Certificate
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-lg">
                            Browse More Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>