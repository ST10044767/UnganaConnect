@model CertificateViewModel
@{
    ViewData["Title"] = "Certificate";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-certificate fa-4x text-warning"></i>
                    </div>
                    
                    <h1 class="text-success mb-4">Congratulations!</h1>
                    <p class="lead">You have successfully completed the course</p>
                    
                    <div class="border p-4 my-4" style="border: 3px solid #28a745; border-radius: 10px;">
                        <h2 class="text-primary">@Model.CourseTitle</h2>
                        <h4 class="my-3">@Model.StudentName</h4>
                        <p class="mb-2">Completion Date: @Model.CompletionDate</p>
                        <p class="mb-0">Final Score: @Model.Score%</p>
                    </div>
                    
                    <div class="mt-4">
                        <a href="@Url.Action("DownloadCertificate", new { id = ViewContext.RouteData.Values["id"] })" class="btn btn-success btn-lg me-3">
                            <i class="fas fa-download me-2"></i>Download Certificate
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-lg">
                            Browse More Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>