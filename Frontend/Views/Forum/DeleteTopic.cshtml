@model ForumTopicViewModel
@{
    ViewData["Title"] = "Delete Topic";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header">
                    <h4 class="mb-0 text-danger">Delete Topic</h4>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5>Are you sure you want to delete this topic?</h5>
                        <p>This action cannot be undone.</p>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Title</h5>
                            <p class="card-text">@Model.Excerpt</p>
                            <div class="text-muted">
                                <small>Category: @Model.Category | Author: @Model.Author | Created: @Model.CreatedAt</small>
                            </div>
                        </div>
                    </div>

                    <form asp-action="DeleteTopic" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Yes, Delete Topic</button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
